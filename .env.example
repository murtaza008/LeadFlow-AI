# ── Database (Neon Postgres — free tier: https://neon.tech) ────────────────
# Create a project, then copy its connection string (the "pooled" one — it
# works fine here since we connect via Neon's serverless driver adapter).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/leadflow_ai?sslmode=require"

# ── Auth (NextAuth.js) ──────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── AI (Google Gemini — free tier: https://aistudio.google.com/apikey) ─────
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# ── Billing (Stripe — optional, free TEST mode: https://dashboard.stripe.com/test/apikeys) ─
# Leave these blank to run in demo billing mode (no Stripe account needed —
# upgrading a plan just flips it instantly with no checkout).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_AGENCY=""

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Public demo ("Try demo") ────────────────────────────────────────────────
# Password of the shared demo account and the secret Vercel Cron sends to the
# daily reset route. Generate each with: openssl rand -base64 32
# Then run `npm run seed:demo` to create the demo workspace.
DEMO_PASSWORD=""
CRON_SECRET=""
